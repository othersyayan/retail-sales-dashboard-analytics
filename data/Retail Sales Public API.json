  "paths": {
    "/health": {
      "get": {
        "tags": ["health"],
        "summary": "Health check",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Service status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok",
                  "version": "1.0.0",
                  "datasetLoaded": true,
                  "totalRecords": 1000
                }
              }
            }
          }
        }
      }
    },
    "/metadata": {
      "get": {
        "tags": ["metadata"],
        "summary": "Dataset metadata",
        "operationId": "metadata_metadata_get",
        "responses": {
          "200": {
            "description": "Dataset ranges and available values",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetadataResponse"
                },
                "example": {
                  "totalRecords": 1000,
                  "availableSortFields": [
                    "age",
                    "date",
                    "pricePerUnit",
                    "quantity",
                    "totalAmount",
                    "transactionId"
                  ],
                  "availableGenders": ["Female", "Male"],
                  "availableCategories": ["Beauty", "Clothing", "Electronics"],
                  "dateRange": {
                    "start": "2023-01-01",
                    "end": "2024-01-01"
                  },
                  "ageRange": {
                    "min": 18,
                    "max": 64
                  },
                  "quantityRange": {
                    "min": 1,
                    "max": 4
                  },
                  "pricePerUnitRange": {
                    "min": 25,
                    "max": 500
                  },
                  "totalAmountRange": {
                    "min": 25,
                    "max": 2000
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
