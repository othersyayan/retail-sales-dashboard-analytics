          "200": {
            "description": "Paginated sales records",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SalesListResponse"
                },
                "example": {
                  "data": [
                    {
                      "transactionId": 1,
                      "date": "2023-11-24",
                      "customerId": "CUST001",
                      "gender": "Male",
                      "age": 34,
                      "productCategory": "Beauty",
                      "quantity": 3,
                      "pricePerUnit": 50,
                      "totalAmount": 150
                    },
                    {
                      "transactionId": 2,
                      "date": "2023-02-27",
                      "customerId": "CUST002",
                      "gender": "Female",
                      "age": 26,
                      "productCategory": "Clothing",
                      "quantity": 2,
                      "pricePerUnit": 500,
                      "totalAmount": 1000
                    }
                  ],
                  "pagination": {
                    "page": 1,
                    "limit": 2,
                    "totalItems": 1000,
                    "totalPages": 500
                  },
                  "filters": {
                    "sortBy": "transactionId",
                    "sortOrder": "asc"
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
